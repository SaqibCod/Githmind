# Required by the Spring Boot backend.
TOKEN_ENCRYPTION_PASSWORD=replace-with-a-long-local-password
TOKEN_ENCRYPTION_SALT=0123456789abcdef

# Required for chat + embeddings. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-api-key

# Required for GitHub OAuth login.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Set this exact value in GitHub Developer Settings > OAuth Apps > your app:
# http://localhost:8080/login/oauth2/code/github